theme = ExtResource("6_g7eoy")
text = "W/UP ARROW: Move Forward
S/DOWN ARROW: Move Backward
A/LEFT ARROW: Turn Left
D/RIGHT ARROW: Turn Right

Click eye to open map
Click arms to eat them

Use movement keys to attack and defend against enemies."
horizontal_alignment = 1
autowrap_mode = 2

