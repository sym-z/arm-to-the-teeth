[node name="Text" type="Label" parent="Text/HBoxContainer/Description/PanelContainer"]
custom_minimum_size = Vector2(1138.22, 0)
layout_mode = 2
theme = ExtResource("6_g7eoy")
text = "You are \"It\", an entity born from the dungeon and capable of regenerating by consuming its own arms at the cost of its teeth. Find chests, teeth, and more powerful arms in the dungeon to increase your chances of survival. Take bites of your arms to regain health and nourish hunger. Pick up teeth to keep eating. 

Manage Its hunger to avoid difficulties in battle, or possibly death from malnourishment. 

Search the dungeon. Find the portal to the next floor. Fight failed creations using your arms as weapons. Survive.

Good luck."
horizontal_alignment = 1
autowrap_mode = 2

